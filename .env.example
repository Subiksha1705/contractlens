# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI Provider: 'openrouter' | 'gemini' | 'mock'
# TIP: Use AI_PROVIDER=mock for testing and development to use 0 API quota!
AI_PROVIDER=openrouter

# OpenRouter Configuration (when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# Pick a free open-weight model on OpenRouter, e.g.:
# - meta-llama/llama-3.3-70b-instruct:free
# - qwen/qwen-2.5-72b-instruct:free
# - mistralai/mistral-small-24b-instruct-2501:free
OPENROUTER_MODEL=cohere/north-mini-code:free

# Gemini Configuration (optional fallback, when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Guards and Limits
MAX_INPUT_CHARS=60000
MAX_UPLOAD_MB=5
